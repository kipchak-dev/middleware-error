{
    "name": "kipchak/middleware-error",
    "type": "middleware",
    "description": "An Error Handling Middleware for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "HTTP",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Middleware\\Error\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "kipchak/core": "^2 || ^3",
        "kipchak/driver-config": "^1",
        "psr/log": "^1 || ^2 || ^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "kipchak/driver-logger": "^1"
    },
    "autoload-dev": {
        "psr-4": {
            "Kipchak\\Middleware\\Error\\Tests\\": "tests/"
        }
    }
}
